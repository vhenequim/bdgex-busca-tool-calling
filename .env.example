# Copie para .env. Nenhum valor aqui e segredo.
OLLAMA_BASE_URL=http://localhost:11434
# Só no docker compose: URL do Ollama do host vista de dentro do contêiner (padrão abaixo); a API local usa a de cima
# PFC_OLLAMA_URL_DOCKER=http://host.docker.internal:11434
PFC_DB_DSN=postgresql://postgres:pfc@localhost:5433/geospatial_search
# Abordagem e modelo da API (pfc abordagens lista as abordagens). O padrao e a configuracao recomendada
# pela tese, a mesma das rodadas results/lote2/tc3-* e results/v3_310/tc3-* (o /api/health confere).
# A v1 do Cap. 4: PFC_ABORDAGEM=tool_calling e PFC_MODELO_PADRAO=qwen3:4b-instruct-2507-q4_K_M
PFC_ABORDAGEM=tool_calling_v3
# Modelo fixo em operacao (RF4: selecao por requisicao e restrita a desenvolvimento, PFC_PERMITIR_MODELO=1)
PFC_MODELO_PADRAO=gemma4:e4b-it-qat
# Opcional: só para a referência em nuvem (pfc-avaliar --provedor groq). Nunca versione o .env.
GROQ_API_KEY=
